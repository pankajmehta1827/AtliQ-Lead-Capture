# Copy to .env. Use a Groq key created for THIS project only.
DATABASE_URL=postgresql://atliq:atliq@localhost:5432/atliq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# The bundled dataset treats "today" as 2026-07-10. Remove this line for real use.
REFERENCE_DATE=2026-07-10

# Shared access code for the hosted demo (leave empty locally).
APP_ACCESS_CODE=
SELLERS=Bhavin,Dhaval,Karandeep,Jay
CORS_ORIGINS=http://localhost:5173

# Kill switch: false pauses all automatic processing (items stay queued).
PROCESSING_ENABLED=true
